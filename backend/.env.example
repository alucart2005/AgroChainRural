# NEAR Testnet — el contrato KV guarda el SHA-256 de cada lote.
#
# Crear la cuenta (genera la clave y la fondea con el faucet de 10 NEAR):
#   python -m scripts.near_account create agrochain-rural.testnet
# Pegar las dos líneas que imprime. La clave secreta SOLO vive aquí (y en el
# panel de Render): nunca se sube al repositorio.
NEAR_NETWORK=testnet
# RPC público de NEAR Testnet. La verificación usa `view get` sobre el ESTADO
# del contrato, no el histórico de transacciones (ese caduca a las ~36 h).
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Cuenta que firma los anclajes.
NEAR_ACCOUNT_ID=
# Clave ed25519 de esa cuenta, con su prefijo: ed25519:...
NEAR_PRIVATE_KEY=
# Cuenta donde está desplegado contract/res/agrochain_kv.wasm
# (python -m scripts.desplegar_contrato).
NEAR_CONTRACT_ID=
FRONTEND_URL=http://localhost:3000

# Cloudflare R2 (S3-compatible) — fotos/evidencia FUERA de la blockchain
#
# Credenciales S3: R2 dashboard → Manage R2 API Tokens → Create API token
# (Object Read & Write, scope al bucket). Son DISTINTAS del token "Edit
# Cloudflare R2" de la API REST de Cloudflare.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=agrochain-evidence
# Dominio público r2.dev del bucket (habilitado en R2 → bucket → Settings)
R2_PUBLIC_URL=

# Base de datos.
#
# DESARROLLO LOCAL: déjalo vacío y se usa SQLite (agrotrace_local.db, ignorado
# por git). Así los experimentos de diario no tocan los datos reales.
#
# PRODUCCIÓN: Neon (proyecto AgroChainRural, aws-us-east-2). En Render va el
# connection string DEL POOLER (el que termina en -pooler), porque el servicio
# web hace muchas conexiones cortas y el endpoint directo agotaría las
# conexiones simultáneas del plan gratuito.
#
# El backend NO lee .env.neon automáticamente. Para tareas puntuales
# (migraciones, arranque puntual contra Neon) se pasa la URL a mano:
#   DATABASE_URL="$(sed -n 's/^DATABASE_URL=//p' .env.neon)" alembic upgrade head
DATABASE_URL=

# API key para endpoints de escritura (header X-API-Key); vacío = API abierta en dev
API_KEY=

# Google OAuth (HU-06 — ingreso de productores).
# Client ID "Web application" de Google Cloud Console; los orígenes autorizados
# deben incluir http://localhost:3000 y https://agrochain-frontend-kappa.vercel.app.
GOOGLE_CLIENT_ID=
# El flujo popup NO lo usa (solo se verifica el ID token con el client_id);
# se guarda por si se añade el intercambio de código más adelante.
GOOGLE_CLIENT_SECRET=

# Secreto con el que el backend firma los JWT de sesión (HS256).
# Generar con: openssl rand -hex 32
# Vacío → POST /api/auth/google responde 503 (login deshabilitado).
AUTH_SECRET=
